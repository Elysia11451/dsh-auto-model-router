{
  "name": "dsh-auto-model-router",
  "version": "0.8.7",
  "description": "DSH 插件，自动路由 Chat/Work 模型，支持免费池降级",
  "repository": "https://github.com/Elysia11451/dsh-auto-model-router",
  "author": "Elysia11451",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "src/routing-policy/",
    "src/leaderboard/",
    "src/switch-controller/",
    "src/first-turn/",
    "src/telemetry/",
    "src/selftest/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-router",
    "reasoning-effort",
    "mobile"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/router.test.mjs && node test/session-mode.test.mjs && node test/crash.test.mjs && node test/leaderboard.test.mjs && node test/first-turn.test.mjs"
  }
}
